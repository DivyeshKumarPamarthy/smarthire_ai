# Copy to .env and fill in. Never commit .env.

PROJECT_NAME="SmartHire AI API"

# PostgreSQL. Create the database in pgAdmin4 first, then put your password here.
DATABASE_URL="postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/smarthire"

# Sign JWTs with this. Generate one with:  openssl rand -hex 32
JWT_SECRET_KEY="replace-with-a-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth2 — create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"

# GitHub OAuth2 — create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must exactly match GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:8000/api/auth/github/callback"

# Which provider handles question generation + résumé extraction: ollama | gemini
#   ollama  local, no API key, no daily quota
#   gemini  cloud, needs a key, free-tier daily quota
#
# Transcription and pronunciation notes (Module 5) always use Gemini whatever
# this is set to — Ollama serves no speech models. Questions are still
# delivered as text; nothing reads them aloud.
AI_PROVIDER="gemini"

# Local Ollama (AI_PROVIDER=ollama). No key needed.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT_SECONDS=300
# Keeps the model in RAM between requests. Ollama's default is 5m, after which
# the next request pays a ~40s reload — noticeable during a live demo.
OLLAMA_KEEP_ALIVE="30m"

# --- Module 9: outgoing email ---
# Nothing is sent until SMTP_HOST is set. Notifications are still recorded and
# shown in the app; they are simply marked "not emailed" instead of vanishing.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, and an
# App Password (not your account password) as SMTP_PASSWORD — Google blocks
# plain password logins. Generate one at myaccount.google.com/apppasswords with
# 2-Step Verification switched on.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Defaults to SMTP_USER, which is what most providers require the sender to be.
SMTP_FROM=""
SMTP_USE_TLS="true"
SMTP_TIMEOUT_SECONDS="20"

# Google Gemini — interview question generation + résumé extraction.
# Free tier, no credit card: https://aistudio.google.com/apikey
# Leave blank to run on the built-in question bank instead — every endpoint,
# including the voice interview, still works end to end without a key.
GEMINI_API_KEY=""
# Extra keys, comma-separated, tried in order once the one before them is out
# of quota. Module 5 spends a request per answer against a daily free tier
# measured in tens, and there is no local speech model to fall back on, so a
# single key caps how many interviews can be transcribed in a day.
# Use only keys you are entitled to: extra projects created purely to multiply
# the free allowance are against Google's terms. The supported ways to lift the
# ceiling are billing on the project, or ANALYSE_ANSWERS=false to run
# interviews without transcription.
GEMINI_API_KEYS=""
# Generation + résumé extraction. A "lite" model is used for its larger
# free-tier daily allowance. Free-tier quotas and model availability change
# without notice — check Google AI Studio → Rate limits for the real number.
GEMINI_MODEL="gemini-3.1-flash-lite"

# Module 5: transcribing a recorded answer and listening to it for
# intelligibility. Needs native audio understanding, so NOT a lite model.
#
# Two Gemini calls per answer (transcribe, then listen), so an 8-question
# interview is 16 requests against the free tier even when AI_PROVIDER=ollama
# is doing every text operation locally for free. The grammar and clarity
# review is a third call, but that one follows AI_PROVIDER and is free on
# Ollama. Set ANALYSE_ANSWERS=false to record answers without transcribing or
# analysing them at all.
GEMINI_STT_MODEL="gemini-3.6-flash"
ANALYSE_ANSWERS=true

# Session webcam video. A person's face on disk: only the candidate who
# recorded it can fetch it back, and every playback is written to
# recording_accesses. The cap is per recording and enforced while streaming.
VIDEO_RECORDING_DIR="uploads/recordings"
MAX_VIDEO_RECORDING_MB=200

# Recorded interview answers. Stored on disk; the size cap is enforced
# server-side on the WebSocket frame, not just in the browser.
ANSWER_AUDIO_DIR="uploads/answers"
MAX_ANSWER_AUDIO_MB=8

# Where to send the browser back to after a successful Google/GitHub login
FRONTEND_URL="http://localhost:3000"

# Origins allowed to call this API
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5453","http://127.0.0.1:3000"]
