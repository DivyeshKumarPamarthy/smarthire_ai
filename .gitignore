Thumbs.db

# Environment / Secret Files
# Covers variants too (.env.local, .env.bak-*, .env.production) — an exact
# ".env" rule alone would let those through.
.env
.env.*
*.env.bak*
!.env.example

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env


# Backend
backend/.venv/
backend/venv/
backend/ENV/
backend/env/
backend/__pycache__/
backend/*.py[cod]
backend/*.db
backend/*.sqlite3
backend/.env
# Uploaded candidate résumés — never commit these.
backend/uploads/

# IDE / Editors
.vscode/
.idea/
*.swp

# Local agent/tooling settings — machine-specific, not part of the project.
.claude/

# Presentation deck and its generator — personal review material, not part of
# the project. Kept local deliberately: the .pptx is a build artifact and
# build_deck.py embeds speaker notes written for one presenter.
SmartHire_AI_Springboard_Final_Review.pptx
build_deck.py

# Generated from docs/PROJECT_REPORT.md by frontend/mkpdf.mjs — regenerate
# rather than commit, so the PDF can never drift from its source.
PROJECT_REPORT.pdf
docs/PROJECT_REPORT.pdf
